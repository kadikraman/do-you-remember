{
  "expo": {
    "name": "Remember?",
    "slug": "do-you-remember",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "doyouremember",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/276fe437-b229-4be3-82f2-99e262ed485c"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.expokadi.doyouremember",
      "associatedDomains": [
        "applinks:do-you-remember.expo.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "XQAX5LF48P"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.expokadi.doyouremember",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "do-you-remember.expo.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9",
          "dark": {
            "backgroundColor": "#FAFAF9"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "276fe437-b229-4be3-82f2-99e262ed485c"
      }
    },
    "owner": "expokadi"
  }
}
