{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "uploadSourceMaps": true,
      "buildArtifactPaths": [
        "ios/build/*.dSYM.zip",
        "android/app/build/outputs/mapping/release/mapping.txt"
      ]
    }
  }
}
